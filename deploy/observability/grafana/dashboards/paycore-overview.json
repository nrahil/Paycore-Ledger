{
  "title": "PayCore — Payment Service & Double-Entry Ledger Overview",
  "uid": "paycore-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Ledger Invariant Drift (Paise — Must Be 0)",
      "type": "stat",
      "targets": [
        {
          "expr": "paycore_ledger_invariant_drift_paise",
          "legendFormat": "Drift (paise)"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Outbox Unpublished Backlog & Oldest Age (s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "paycore_outbox_unpublished_rows",
          "legendFormat": "Unpublished Rows"
        },
        {
          "expr": "paycore_outbox_oldest_unpublished_age_seconds",
          "legendFormat": "Oldest Age (s)"
        }
      ],
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Payment API Requests / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"payments-core\",uri=~\"/v1/payments.*\"}[1m]))",
          "legendFormat": "{{uri}} ({{status}})"
        }
      ],
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 }
    },
    {
      "id": 4,
      "title": "Payment API Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payments-core\",uri=~\"/v1/payments.*\"}[1m])))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payments-core\",uri=~\"/v1/payments.*\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payments-core\",uri=~\"/v1/payments.*\"}[1m])))",
          "legendFormat": "p50"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "title": "Gateway Requests and Rate Limits / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(paycore_gateway_requests_total[1m])",
          "legendFormat": "Gateway requests"
        },
        {
          "expr": "rate(paycore_gateway_rate_limited_total[1m])",
          "legendFormat": "Rate limited"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ]
}
